insert into product (name, productCategoryId, description, image, featured, cost, discount, created, sold) values
('Spring Rising', 1, 'A set representing mother nature''s birth of a new season', null, 1, 60.00, 0, datetime('now'), null);

SELECT * FROM product WHERE id = 1 ;

