dths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="promo_code" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="28"/><column index="2" value="90"/><column index="3" value="49"/><column index="4" value="78"/><column index="5" value="116"/><column index="6" value="111"/><column index="7" value="93"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="referral" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="28"/><column index="2" value="102"/><column index="3" value="49"/><column index="4" value="78"/><column index="5" value="73"/><column index="6" value="93"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Scratch">update product set is_sold = 0, reserved_at = NULL;

SELECT 
      p.id, p.name, p.cover_image_path,
      p.cover_price / 100 AS cover_price, p.is_sold,
      pc.code, pc.description,
      pt.id AS tag_id, pt.code AS tag_code, pt.name AS tag_name
    FROM product p
    JOIN product_category pc ON pc.id = p.category_id
    JOIN product_tag_map pm ON pm.product_id = p.id
    JOIN product_tag pt ON pt.id = pm.tag_id
    WHERE NOT p.is_sold AND p.reserved_at IS NULL AND pc.code = 'dice';
    ORDER BY p.created_at DESC;</sql><sql name="Seed*">SELECT id, name, is_sold, reserved_at FROM product;

UPDATE product SET is_sold = 0, reserved_at = NULL;</sql><current_tab id="1"/></tab_sql></sqlb_project>
