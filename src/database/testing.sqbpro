mn_widths><column index="1" value="26"/><column index="2" value="76"/><column index="3" value="195"/><column index="4" value="74"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="101"/><column index="2" value="30"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">select * from product;

-- insert into product (name, productCategoryId, description, featured, cost, discount, created, sold) values
-- ('Fall Setting', 1, 'A set to showcase fall vibes', 1, 35.00, 15.0, datetime('now'), null);

SELECT * FROM product;

SELECT * FROM product WHERE featured = 1 AND sold IS NULL;

SELECT * FROM product WHERE sold IS NULL ORDER BY created DESC LIMIT 3;

select * from productImage;

-- update lookups set key = 'productcategory';

update product set cost = 0, discount = 0;

select * from lookups;

-- insert into productImage (productId, path, sequence) values (1, 'dice/20250102_162901.jpg', 1);
-- insert into productImage (productId, path, sequence) values (1, 'dice/20250316_143711.jpg', 1);
-- insert into productImage (productId, path, sequence) values (2, 'dice/20250420_091540.jpg', 1);

SELECT p.id, p.name, p.description, p.cost, p.discount, pi.path
FROM product p 
JOIN productImage pi on p.id = pi.productId
WHERE p.id = 2 AND sold IS NULL;

SELECT * FROM product WHERE featured = 1 AND sold IS NULL LIMIT 3;

SELECT p.id, p.name, p.description, p.cost, p.discount, pi.path
     FROM product p 
     JOIN productImage pi on p.id = pi.productId
     WHERE p.id = 1 AND sold IS NULL;

	 
SELECT p.id, p.name, p.description, p.cost, p.discount, pi.path
FROM product p 
JOIN productImage pi on p.id = pi.productId
WHERE p.featured = 1 AND p.sold IS NULL ORDER BY p.created DESC;

SELECT p.id, p.name, p.description, p.cost, p.discount, pi.path AS images
FROM product p 
JOIN productImage pi on p.id = pi.productId
WHERE p.featured = 1 AND p.sold IS NULL ORDER BY p.created DESC LIMIT 3;



SELECT p.id, p.name, p.description, p.cost / 100.0, p.discount, pi.path AS imagePath
FROM product p
LEFT JOIN productImage pi ON p.id = pi.productId
WHERE p.id IN (
  SELECT id FROM product
  WHERE featured = 1 AND sold IS NULL
  ORDER BY created DESC
  LIMIT 3
)
ORDER BY p.created DESC;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
