select * from productImage;



SELECT p.id, p.name, p.description, p.cost / 100.0, pi.path AS images
     FROM product p
     LEFT JOIN productImage pi ON p.id = pi.productId
     WHERE p.id IN (
       SELECT id FROM product
       WHERE sold IS NULL AND p.id = 1
     )
     ORDER BY p.created DESC;
	 
select * from productOption;
	 
insert into productOption (productId, code, description, price, sold, sequence) values (1, 'set7', 'Dice Set', 4000, NULL, 1);
insert into productOption (productId, code, description, price, sold, sequence) values (1, 'set7chonk', 'Dice Set + 33mm d20 Chonk', 4000, NULL, 2);
