ort><column_widths><column index="1" value="26"/><column index="2" value="106"/><column index="3" value="93"/><column index="4" value="62"/><column index="5" value="74"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="productImage" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="26"/><column index="2" value="76"/><column index="3" value="195"/><column index="4" value="74"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="101"/><column index="2" value="30"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">select * from product;

insert into product (name, productCategoryId, description, featured, cost, discount, created, sold) values
('Domino Double 5', 1, 'A elegant black &amp; gold double five necklace.', 3, 2500, 0, datetime('now'), null);

SELECT * FROM product;

SELECT * FROM product WHERE featured = 1 AND sold IS NULL;

SELECT * FROM product WHERE sold IS NULL ORDER BY created DESC LIMIT 3;

select * from productImage;




