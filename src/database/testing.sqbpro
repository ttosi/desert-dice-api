SELECT p.id, p.name, p.description, p.cost, p.discount, pi.path
FROM product p 
JOIN productImage pi on p.id = pi.productId
WHERE p.id = 2 AND sold IS NULL;

SELECT * FROM product WHERE featured = 1 AND sold IS NULL LIMIT 3;

SELECT p.id, p.name, p.description, p.cost, p.discount, pi.path
     FROM product p 
     JOIN productImage pi on p.id = pi.productId
     WHERE p.id = 1 AND sold IS NULL;

	 
SELECT p.id, p.name, p.description, p.cost, p.discount, pi.path
FROM product p 
JOIN productImage pi on p.id = pi.productId
WHERE p.featured = 1 AND p.sold IS NULL ORDER BY p.created DESC;

SELECT p.id, p.name, p.description, p.cost, p.discount, pi.path AS images
FROM product p 
JOIN productImage pi on p.id = pi.productId
WHERE p.featured = 1 AND p.sold IS NULL ORDER BY p.created DESC LIMIT 3;



SELECT p.id, p.name, p.description, p.cost / 100.0, p.discount, pi.path AS imagePath
FROM product p
LEFT JOIN productImage pi ON p.id = pi.productId
WHERE p.id IN (
  SELECT id FROM product
  WHERE featured = 1 AND sold IS NULL
  ORDER BY created DESC
  LIMIT 3
)
ORDER BY p.created DESC;



SELECT p.id, p.name, p.description, p.cost / 100.0 as cost, p.discount, pi.path AS images
 FROM product p
 LEFT JOIN productImage pi ON p.id = pi.productId
 WHERE p.id IN (
   SELECT p.id FROM product p
   JOIN productCategory pc ON pc.id = p.productCategoryId
   WHERE p.sold IS NULL AND pc.key = 'dice'
 )
 ORDER BY p.created ASC;
 
 
 SELECT p.id, p.name, p.description, p.cost / 100.0 as cost, p.discount, pi.path AS images
 FROM product p
 LEFT JOIN productImage pi ON p.id = pi.productId
 WHERE p.id IN (
   SELECT p.id FROM product p
   JOIN productCategory pc ON pc.id = p.productCategoryId
   WHERE p.sold IS NULL AND pc.key = 'jewelry'
 )
 ORDER BY p.created DESC;
 
 
 SELECT p.id, p.name, p.description, p.cost / 100.0 as cost, p.discount, pi.path AS images
     FROM product p
     LEFT JOIN productImage pi ON p.id = pi.productId
     WHERE p.id IN (
       SELECT p.id FROM product p
       JOIN productCategory pc ON pc.id = p.productCategoryId
       WHERE p.sold IS NULL AND pc.category = 'jewelry'
     )
     ORDER BY p.created DESC;
	 

	 
