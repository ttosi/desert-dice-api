                    <TD PORT="productOptionId_to">&nbsp;</TD>
                    <TD PORT="productOptionId_from">productOptionId</TD>
                </TR>
            
            </TABLE>
        >];
        
product [label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLBORDER="1">
                <TR>
                    <TD COLSPAN="2"><B>product</B></TD>
                </TR>
            
                <TR>
                    <TD PORT="id_to">🔑</TD>
                    <TD PORT="id_from">id</TD>
                </TR>
            

                <TR>
                    <TD PORT="productCategoryId_to">&nbsp;</TD>
