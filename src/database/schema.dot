                    <TD PORT="description_from">description</TD>
                </TR>
            

                <TR>
                    <TD PORT="isActive_to">&nbsp;</TD>
                    <TD PORT="isActive_from">isActive</TD>
                </TR>
            

                <TR>
                    <TD PORT="sequence_to">&nbsp;</TD>
