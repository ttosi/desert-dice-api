productType [label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLBORDER="1">
                <TR>
                    <TD COLSPAN="2"><B>productType</B></TD>
                </TR>
            
                <TR>
                    <TD PORT="id_to">🔑</TD>
                    <TD PORT="id_from">id</TD>
                </TR>
            

                <TR>
                    <TD PORT="code_to">&nbsp;</TD>
                    <TD PORT="code_from">code</TD>
                </TR>
            
            </TABLE>
        >];
        
product:productCategoryId_from:e -> productCategory:id_to:w
customerOrder:productOptionId_from:e -> productOption:id_to:w
customerOrder:customerId_from:e -> customer:id_to:w
productImage:productId_from:e -> product:id_to:w
customerAddress:customerId_from:e -> customer:id_to:w
productOption_productType:productTypeId_from:e -> productType:id_to:w
productOption_productType:productOptionId_from:e -> productOption:id_to:w
productOption:productId_from:e -> product:id_to:w

}
