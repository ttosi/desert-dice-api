        >];
        
productOption_productType [label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLBORDER="1">
                <TR>
                    <TD COLSPAN="2"><B>productOption_productType</B></TD>
                </TR>
            
                <TR>
                    <TD PORT="productOptionId_to">🔑</TD>
                    <TD PORT="productOptionId_from">productOptionId</TD>
                </TR>
            

