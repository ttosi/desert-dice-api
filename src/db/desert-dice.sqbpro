"" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="26"/><column index="2" value="62"/><column index="3" value="78"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">insert into customer (email, first_name, last_name) values ('john@email.com', 'John', 'Doe');


select * from customer;

SELECT
	p.id, p.name, p.cover_image_path AS coverImagePath, p.cover_price AS coverPrice,
	p.is_sold AS isSold
 FROM product p
 JOIN product_tag_map pt ON pt.product_id = p.id
 JOIN product_tag_map pm ON pm.tag_id = 
 WHERE NOT p.is_sold AND pc.route = ?
 ORDER BY p.created_at DESC;

select * from product_tag_map;

SELECT
  p.id, p.name, p.cover_image_path as coverImagePath, p.cover_price AS coverPrice, p.is_sold
FROM product p
JOIN product_tag_map ptm ON ptm.product_id = p.id
JOIN product_tag pt ON pt.id = ptm.tag_id
WHERE pt.code IN ('fullset', 'misfit')
ORDER BY created_at DESC; 

select * from product_tag;

select * from product_tag_map;

insert into product_tag_map (product_id, tag_id) values (2, 3);

SELECT
        p.id, p.name, p.cover_image_path AS coverImagePath, p.cover_price AS coverPrice,
        p.is_sold AS isSold
     FROM product p
     JOIN product_category pc ON pc.id = p.category_id
     WHERE NOT p.is_sold AND pc.route = 'dice'
     ORDER BY p.created_at DESC;

select * from product;

UPDATE product SET is_sold = 1, reserved_at = CURRENT_TIMESTAMP where id = 2;

UPDATE product SET is_sold = 0, reserved_at = NULL;

select is_sold from product;

select CURRENT_TIMESTAMP;</sql><sql name="SQL 2">select * from product;</sql><sql name="desert-dice-schema.sql*" filename="/home/ttosi/Projects/desert-dice-company/website/desert-dice-api/src/database/desert-dice-schema.sql">-- Reference to file &quot;/home/ttosi/Projects/desert-dice-company/website/desert-dice-api/src/database/desert-dice-schema.sql&quot; (not supported by this version) --</sql><current_tab id="2"/></tab_sql></sqlb_project>
