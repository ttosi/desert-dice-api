        <mxCell id="T6I3gG0kRrgbXN8CNnat-27" value="&lt;div style=&quot;text-align: left; padding-left: 10px; padding-right: 10px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cart icon in the upper right shows the correct number of items in the their cart. &lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(153, 76, 0), rgb(255, 255, 255));&quot; face=&quot;Courier New&quot;&gt;Database: product table -&amp;gt; is_sold = 0, is_reserved = datetime (UTC). Local Storage: cart value reflects items in cart.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
