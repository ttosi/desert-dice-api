        <mxCell id="T6I3gG0kRrgbXN8CNnat-36" value="&lt;div style=&quot;text-align: left; padding-left: 10px; padding-right: 10px;&quot;&gt;Shows 4 steps: Email Address, Shipping Address, Payment Information, Confirmation. It defaults to the Email Address step. Only the active step is visible. Step 1: user enters email address.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
